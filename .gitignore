# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage
/test-results/

# next.js
/.next/
/.next-*/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env.local
/tests
# logs
*.log

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Database credentials
.env
.env.*
!.env.example

# cache
npm-cache/
*.js
*.sql
*.spec.ts
*.test.ts
!src/**/*.test.ts
!src/**/*.spec.ts
# Migration SQL + rollback: phải version được, nếu không teammate chạy
# prisma migrate diff sẽ thấy drift mà không có file giải thích vì sao.
!prisma/sql/*.sql

*.MD

# MoM 30/10 task cards and implementation notes; generated customer rows stay local.
!/workflows/plans/mom-2026-10-30-production-reports-auth-plan.md
!/workflows/plans/mom-2026-10-30-tasks/*.md
!/workflows/context/mom-2026-10-30/*.md
!/workflows/context/handover-2026-11-09.md
/workflows/context/mom-2026-10-30/*.csv
/workflows/context/mom-2026-10-30/*.json

# Agent harness (versioned)
!/AGENTS.md
!/CLAUDE.md
!/.agents/**
